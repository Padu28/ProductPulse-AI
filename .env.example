# Copy this file to ".env" for your own notes, or set the variables in your terminal.
# NEVER commit a real key. ".env" is listed in .gitignore.

# Your Google Cloud project ID (used by scripts/export_from_bigquery.py --project)
GOOGLE_CLOUD_PROJECT=your-project-id

# Optional: only needed for live Claude answers in scripts/ask_claude.py and the Streamlit app
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
